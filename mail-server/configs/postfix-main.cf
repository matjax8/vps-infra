# Basic
myhostname = mail.mattjack.cloud
mydomain = mattjack.cloud
myorigin = $mydomain
inet_interfaces = all
inet_protocols = all

# Destinations — only local delivery for our domain
mydestination = $myhostname, localhost.$mydomain, localhost
mynetworks = 127.0.0.0/8 [::ffff:127.0.0.0]/104 [::1]/128

# Delivery to Maildir
home_mailbox = Maildir/

# Virtual aliases (e.g. claude@mattjack.cloud -> local claude user)
virtual_alias_domains = mattjack.cloud
virtual_alias_maps = hash:/etc/postfix/virtual

# TLS inbound (SMTPS / STARTTLS)
smtpd_tls_cert_file = /etc/letsencrypt/live/mail.mattjack.cloud/fullchain.pem
smtpd_tls_key_file  = /etc/letsencrypt/live/mail.mattjack.cloud/privkey.pem
smtpd_tls_security_level = may
smtpd_tls_session_cache_database = btree:${data_directory}/smtpd_scache
smtpd_tls_loglevel = 1

# TLS outbound
smtp_tls_security_level = may
smtp_tls_session_cache_database = btree:${data_directory}/smtp_scache
smtp_tls_loglevel = 1

# SASL auth via Dovecot
smtpd_sasl_type = dovecot
smtpd_sasl_path = private/auth
smtpd_sasl_auth_enable = yes
smtpd_sasl_security_options = noanonymous

# SMTP restrictions
smtpd_relay_restrictions =
    permit_mynetworks,
    permit_sasl_authenticated,
    reject_unauth_destination

smtpd_recipient_restrictions =
    permit_mynetworks,
    permit_sasl_authenticated,
    reject_unauth_destination

# DKIM milter
milter_default_action = accept
milter_protocol = 6
smtpd_milters = inet:localhost:8891
non_smtpd_milters = inet:localhost:8891

# Misc
biff = no
append_dot_mydomain = no
readme_directory = no
compatibility_level = 3.6
